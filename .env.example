NODE_ENV=production
PORT=8080
PUBLIC_ORIGIN=https://teachers.example.com
MONGODB_URI=mongodb://sampad_app:REPLACE_WITH_DB_PASSWORD@127.0.0.1:27017/sampad?authSource=sampad
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_BYTES
SECURITY_CODE_HASH=
ADMIN_NATIONAL_ID=0000000000
ADMIN_FIRST_NAME=مدیر
ADMIN_LAST_NAME=مدرسه
ADMIN_PHONE=0000000000
ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_6_CHARACTERS_AND_KEEP_FOR_MANAGER_CONNECTION
COOKIE_SECURE=true
TRUST_PROXY=1
LOG_LEVEL=info

# Set true once to provision the first admin automatically at app startup (no Shell required).
ADMIN_AUTO_PROVISION=false
